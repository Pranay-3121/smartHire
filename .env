APP_NAME=Resume Ranker
APP_VERSION=1.0.0
DEBUG=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=resume_embeddings

UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

MAX_FILE_SIZE_MB=10
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
